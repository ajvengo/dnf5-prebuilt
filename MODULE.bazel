module(
    name = "dnf5-prebuilt",
    version = "0.0.1",
)

# Core Bazel & platform dependencies from BCR (latest published versions)
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "platforms_contrib", version = "1.0.0-alpha.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.7.2", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.26", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "tar.bzl", version = "0.10.9", dev_dependency = True)

# Hermetic LLVM C/C++ toolchain from BCR
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# Remote Execution Platform setup from BCR
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4", dev_dependency = True)

buildbuddy = use_extension(
    "@toolchains_buildbuddy//:extensions.bzl",
    "buildbuddy",
    dev_dependency = True,
)
buildbuddy.platform(
    container_image = "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:be9853fc45092d2cf2bda3abed30d22182881659a50bf35c7125161d7cfc8a75",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

# Dependencies used to build dnf5 from source. Modules not available in the
# BCR live in the local registry under bazel/3rdparty. All of them are dev-only:
# consumers of the dnf5-prebuilt ruleset download prebuilt binaries instead.
bazel_dep(name = "toml11", version = "4.4.0", dev_dependency = True)
bazel_dep(name = "json-c", version = "0.19", dev_dependency = True)
