load("@rules_cc//cc:defs.bzl", "cc_test")

# Link/run smoke tests for the libraries in the local registry
# (bazel/3rdparty). They must build for every platform in //bazel.

cc_test(
    name = "smartcols_test",
    srcs = ["smartcols_test.c"],
    linkstatic = True,
    deps = ["@libsmartcols//:smartcols"],
)

cc_test(
    name = "acl_test",
    srcs = ["acl_test.c"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@libacl//:acl"],
)

cc_test(
    name = "rpm_test",
    srcs = ["rpm_test.cc"],
    linkstatic = True,
    deps = [
        "@rpm",
        "@rpm//:librpmbuild",
    ],
)

cc_test(
    name = "libsolv_test",
    srcs = ["libsolv_test.c"],
    linkstatic = True,
    deps = ["@libsolv//:libsolvext"],
)

cc_test(
    name = "librepo_test",
    srcs = ["librepo_test.c"],
    linkstatic = True,
    deps = ["@librepo"],
)
