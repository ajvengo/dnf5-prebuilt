--- a/Cargo.toml	2026-10-28 13:22:23.407113194 +0100
+++ b/Cargo.toml	2026-10-28 13:22:23.418113182 +0100
@@ -42,9 +42,13 @@
 
 # We explicitly do not want to enable Sequoia's decompression support.
 # Hence we only select a crypto backend.
-default = ["crypto-nettle"]
+# Bazel build: default to the pure-Rust backend so no C crypto library
+# (nettle, OpenSSL, ...) is needed and cross-compilation stays hermetic.
+# rpm only uses rpm-sequoia to verify signatures over public data, so
+# Sequoia's variable-time and experimental-crypto caveats do not apply.
+default = ["crypto-rust"]
 crypto-nettle = ["sequoia-openpgp/crypto-nettle"]
-crypto-rust = ["sequoia-openpgp/crypto-rust"]
+crypto-rust = ["sequoia-openpgp/crypto-rust", "sequoia-openpgp/allow-experimental-crypto", "sequoia-openpgp/allow-variable-time-crypto"]
 crypto-cng = ["sequoia-openpgp/crypto-cng"]
 crypto-openssl = ["sequoia-openpgp/crypto-openssl"]
 crypto-botan = ["sequoia-openpgp/crypto-botan"]
