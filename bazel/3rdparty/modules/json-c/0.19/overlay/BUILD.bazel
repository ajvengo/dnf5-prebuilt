load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

exports_files(["COPYING"])

PUBLIC_HDRS = [
    "arraylist.h",
    "debug.h",
    "json.h",
    "json_c_version.h",
    "json_config.h",
    "json_inttypes.h",
    "json_object.h",
    "json_object_iterator.h",
    "json_patch.h",
    "json_pointer.h",
    "json_tokener.h",
    "json_types.h",
    "json_util.h",
    "json_visit.h",
    "linkhash.h",
    "printbuf.h",
]

# Sources and private headers. `includes = ["."]` mirrors the pkg-config
# cflags (-I/usr/include/json-c) so consumers may use both <json.h> and
# <json-c/json.h>.
cc_library(
    name = "json_c_impl",
    srcs = [
        "arraylist.c",
        "config.h",
        "debug.c",
        "json_c_version.c",
        "json_object.c",
        "json_object_iterator.c",
        "json_object_private.h",
        "json_patch.c",
        "json_pointer.c",
        "json_pointer_private.h",
        "json_tokener.c",
        "json_util.c",
        "json_visit.c",
        "linkhash.c",
        "math_compat.h",
        "printbuf.c",
        "random_seed.c",
        "random_seed.h",
        "snprintf_compat.h",
        "strdup_compat.h",
        "strerror_override.c",
        "strerror_override.h",
        "vasprintf_compat.h",
    ],
    hdrs = PUBLIC_HDRS,
    copts = [
        "-ffunction-sections",
        "-fdata-sections",
        "-D_REENTRANT",
    ],
    includes = ["."],
    local_defines = ["_GNU_SOURCE"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "json-c",
    hdrs = PUBLIC_HDRS,
    include_prefix = "json-c",
    deps = [":json_c_impl"],
)
