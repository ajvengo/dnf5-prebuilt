load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["restricted"])  # LGPL-2.1-or-later

exports_files(["libsmartcols/COPYING"])

# The subset of util-linux's libcommon used by libsmartcols.
LIBCOMMON_SRCS = [
    "lib/buffer.c",
    "lib/color-names.c",
    "lib/debug.c",
    "lib/jsonwrt.c",
    "lib/mbsalign.c",
    "lib/strutils.c",
    "lib/ttyutils.c",
]

# util-linux internal headers plus the configure-time headers. Used as an
# implementation dep so these generic names (c.h, debug.h, ...) never leak
# into consumers' include paths.
cc_library(
    name = "ul_internal_headers",
    hdrs = glob(["include/*.h"]) + [
        "bazel/config.h",
        "bazel/libsmartcols.h",
    ],
    includes = [
        "bazel",
        "include",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "smartcols",
    srcs = LIBCOMMON_SRCS + [
        "libsmartcols/src/calculate.c",
        "libsmartcols/src/cell.c",
        "libsmartcols/src/column.c",
        "libsmartcols/src/filter.c",
        "libsmartcols/src/filter-expr.c",
        "libsmartcols/src/filter-param.c",
        # Pre-generated by bison/flex in the release tarball.
        "libsmartcols/src/filter-parser.c",
        "libsmartcols/src/filter-parser.h",
        "libsmartcols/src/filter-scanner.c",
        "libsmartcols/src/filter-scanner.h",
        "libsmartcols/src/grouping.c",
        "libsmartcols/src/init.c",
        "libsmartcols/src/iter.c",
        "libsmartcols/src/line.c",
        "libsmartcols/src/print.c",
        "libsmartcols/src/print-api.c",
        "libsmartcols/src/smartcolsP.h",
        "libsmartcols/src/symbols.c",
        "libsmartcols/src/table.c",
        "libsmartcols/src/version.c",
        "libsmartcols/src/walk.c",
    ],
    hdrs = ["bazel/libsmartcols.h"],
    copts = [
        "-include",
        "config.h",
        "-fsigned-char",
    ],
    implementation_deps = [":ul_internal_headers"],
    include_prefix = "libsmartcols",
    local_defines = [
        'LOCALEDIR=\\"/usr/share/locale\\"',
        '_PATH_RUNSTATEDIR=\\"/run\\"',
    ],
    strip_include_prefix = "bazel",
)
